# DevMate 환경 변수 템플릿
# 사용법: 이 파일을 복사해서 .env 파일 생성 후 실제 값 입력

# ============================================
# 🧠 로컬 LLM (Ollama) — API 키 필요 없음
# ============================================
# Ollama 서버 주소
OLLAMA_BASE_URL=http://localhost:11434

# 답변 생성 모델 (웹 UI에서는 설치된 모델 중 고를 수 있음)
# 설치: ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# 검색용 임베딩 모델 (한국어·영어 지원)
# 설치: ollama pull bge-m3
# 바꾸면 python scripts/init_index.py 로 인덱스를 다시 만들어야 함
OLLAMA_EMBED_MODEL=bge-m3

# 생성 온도 (0.0 = 결정적, 1.0 = 창의적)
LLM_TEMPERATURE=0.0

# 답변 최대 길이 (토큰)
LLM_MAX_TOKENS=1500

# ============================================
# 🗄️ 데이터베이스
# ============================================
# SQLite 경로
DATABASE_URL=sqlite+aiosqlite:///./data/database/devmate.db

# ============================================
# 📁 파일 저장소
# ============================================
# 업로드된 문서 저장 경로
DOCUMENTS_PATH=./data/documents

# 벡터 스토어 인덱스 저장 경로
VECTOR_STORE_PATH=./data/vector_store

# 로그 파일 경로
LOGS_PATH=./logs

# ============================================
# 🔍 벡터 검색 설정
# ============================================
# 유사도 검색 시 반환할 청크 수
SIMILARITY_TOP_K=3

# 청크 분할 크기 (토큰 단위)
CHUNK_SIZE=1000

# 청크 오버랩 크기
CHUNK_OVERLAP=200

# ============================================
# 🚀 서버 설정
# ============================================
# FastAPI 서버 호스트
API_HOST=0.0.0.0

# FastAPI 서버 포트
API_PORT=8000

# 환경 (development | production)
ENVIRONMENT=development

# 디버그 모드
DEBUG=True

# ============================================
# 📊 모니터링 & 로깅
# ============================================
# 로그 레벨 (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# 성능 메트릭 수집
ENABLE_PERFORMANCE_METRICS=True

# ============================================
# 🎨 UI 설정 (Streamlit)
# ============================================
# Streamlit 포트
STREAMLIT_PORT=8501

# ============================================
# 🔒 보안 (Phase 2 이후)
# ============================================
# JWT Secret Key (사용자 인증 구현 시)
# JWT_SECRET_KEY=your-secret-key-here

# 세션 타임아웃 (초)
# SESSION_TIMEOUT=3600
