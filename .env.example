# DevMate 환경 변수 템플릿
# 사용법: 이 파일을 복사해서 .env 파일 생성 후 실제 값 입력

# ============================================
# 🔑 API Keys
# ============================================
# OpenAI API Key (필수)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# OpenAI 모델 선택 (선택사항, 기본값: gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_MODEL=gpt-4  # 더 정확하지만 비용 30배

# OpenAI 온도 설정 (0.0 = 결정적, 1.0 = 창의적)
OPENAI_TEMPERATURE=0.0

# ============================================
# 🗄️ 데이터베이스
# ============================================
# SQLite 경로
DATABASE_URL=sqlite+aiosqlite:///./data/database/devmate.db

# ============================================
# 📁 파일 저장소
# ============================================
# 업로드된 문서 저장 경로
DOCUMENTS_PATH=./data/documents

# 벡터 스토어 인덱스 저장 경로
VECTOR_STORE_PATH=./data/vector_store

# 로그 파일 경로
LOGS_PATH=./logs

# ============================================
# 🔍 벡터 검색 설정
# ============================================
# 유사도 검색 시 반환할 청크 수
SIMILARITY_TOP_K=3

# 청크 분할 크기 (토큰 단위)
CHUNK_SIZE=1000

# 청크 오버랩 크기
CHUNK_OVERLAP=200

# ============================================
# 🚀 서버 설정
# ============================================
# FastAPI 서버 호스트
API_HOST=0.0.0.0

# FastAPI 서버 포트
API_PORT=8000

# 환경 (development | production)
ENVIRONMENT=development

# 디버그 모드
DEBUG=True

# ============================================
# 📊 모니터링 & 로깅
# ============================================
# 로그 레벨 (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# 비용 추적 활성화
ENABLE_COST_TRACKING=True

# 성능 메트릭 수집
ENABLE_PERFORMANCE_METRICS=True

# ============================================
# 🎨 UI 설정 (Streamlit)
# ============================================
# Streamlit 포트
STREAMLIT_PORT=8501

# ============================================
# 🔒 보안 (Phase 2 이후)
# ============================================
# JWT Secret Key (사용자 인증 구현 시)
# JWT_SECRET_KEY=your-secret-key-here

# 세션 타임아웃 (초)
# SESSION_TIMEOUT=3600

# ============================================
# 🧪 테스트 환경
# ============================================
# 테스트용 OpenAI Key (별도 계정 권장)
# TEST_OPENAI_API_KEY=sk-...test-key...

# 테스트 데이터 경로
# TEST_DATA_PATH=./tests/fixtures
